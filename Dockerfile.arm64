# Creates the base image since downloading dependencies take a lot of time
FROM python:3.12-slim
ARG TARGETPLATFORM=linux/arm64
LABEL maintainer="hanisaf@uga.edu"
RUN apt-get update && apt-get install -y build-essential chromium chromium-driver netcat-traditional

# Build XQilla (XQuery engine) from source, needed by python-simplexquery.
# Debian dropped libxqilla-dev after bullseye, so compile it against the system Xerces-C.
RUN apt-get update && apt-get install -y --no-install-recommends curl autotools-dev libxerces-c-dev \
 && curl -fsSL -o /tmp/xqilla.tar.gz https://downloads.sourceforge.net/project/xqilla/XQilla-2.3.4.tar.gz \
 && tar -xzf /tmp/xqilla.tar.gz -C /tmp \
 && cd /tmp/XQilla-2.3.4 \
 && find . -name config.guess -exec cp /usr/share/misc/config.guess {} \; \
 && find . -name config.sub -exec cp /usr/share/misc/config.sub {} \; \
 && ./configure --with-xerces=/usr --prefix=/usr/local CXXFLAGS="-O2 -std=gnu++14 -w" \
 && make -j"$(nproc)" \
 && make install \
 && ldconfig \
 && cd / && rm -rf /tmp/XQilla-2.3.4 /tmp/xqilla.tar.gz /var/lib/apt/lists/*

# Install python-simplexquery, patched to allocate with malloc/free instead of
# PyMem_Malloc/PyMem_Free: its C++ operator new/delete overrides otherwise mix
# allocators and crash with "free(): invalid size" (e.g. under IPython/Jupyter).
RUN pip download --no-deps --no-binary :all: --no-cache-dir python-simplexquery==1.0.5.3 -d /tmp/sxq \
 && cd /tmp/sxq && python -m zipfile -e python-simplexquery-1.0.5.3.zip . \
 && cd python-simplexquery-1.0.5.3 \
 && sed -i 's/&PyMem_Malloc/\&malloc/; s/&PyMem_Free/\&free/' xquery.c \
 && grep -q 'return &malloc' xquery.c && grep -q 'return &free' xquery.c \
 && pip install --no-cache-dir . \
 && cd / && rm -rf /tmp/sxq
COPY requirements.txt /
RUN python -m pip install --no-cache-dir -r requirements.txt
RUN python -m textblob.download_corpora
RUN python -m spacy download en_core_web_sm

# Add Debian Bookworm repo (for OpenJDK 17)
RUN echo "deb http://deb.debian.org/debian bookworm main" > /etc/apt/sources.list.d/bookworm.list

# Pin Bookworm lower priority except when explicitly requested
RUN printf "Package: *\nPin: release n=bookworm\nPin-Priority: 100\n" > /etc/apt/preferences.d/bookworm

# Install OpenJDK 17 specifically from Bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends -t bookworm openjdk-17-jdk \
 && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
ENV PATH="$JAVA_HOME/bin:$PATH"
ENV SPARK_LOCAL_IP=127.0.0.1 \
    SPARK_LOCAL_HOSTNAME=localhost \
    PYSPARK_SUBMIT_ARGS="--master local[1] \
    --conf spark.driver.host=127.0.0.1 \
    --conf spark.driver.bindAddress=127.0.0.1 \
    --conf spark.local.ip=127.0.0.1 \
    --conf spark.driver.extraJavaOptions=-Djava.net.preferIPv4Stack=true \
    pyspark-shell"

# Install PySpark 4
RUN pip install --no-cache-dir "pyspark>=4.0.0"

# Force Spark to download dependencies at build time
RUN python -c "\
from pyspark.sql import SparkSession; \
SparkSession.builder \
    .appName('preload') \
    .config('spark.jars.packages', 'org.apache.hadoop:hadoop-aws:3.5.0') \
    .getOrCreate().stop()"

COPY . /app
WORKDIR /app
# copy ipython config into a temporary location and move it to the IPython
# profile directory discovered at build time
COPY ipython_config.py /tmp/ipython_config.py
RUN dest=$(ipython profile locate) \
	&& mkdir -p "$dest" \
	&& cp /tmp/ipython_config.py "$dest/ipython_config.py" \
	&& rm /tmp/ipython_config.py || true